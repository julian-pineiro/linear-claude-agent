# Repo the sessions work in, and the branch they start from.
REPO_PATH=/Users/you/dev/your-repo
BASE_BRANCH=origin/main

# From the Linear OAuth application (Settings -> API -> OAuth Applications).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# App token from `node scripts/authorize.mjs`. Acts as the agent in Linear.
LINEAR_TOKEN=

# Public HTTPS origin Linear reaches this machine on — no trailing slash.
PUBLIC_URL=https://your-domain.ngrok-free.dev
NGROK_DOMAIN=your-domain.ngrok-free.dev

# Optional.
PORT=3456
DEFAULT_MODEL=sonnet
# WORKTREE_DIR=/Users/you/.linear-claude/worktrees
# Comma-separated; replaces the built-in list entirely.
# DISALLOWED_TOOLS=Bash(rm -rf:*),Bash(gh pr merge:*),Read(~/.ssh/**)
